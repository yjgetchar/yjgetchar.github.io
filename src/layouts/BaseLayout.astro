---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConstellationCanvas from '../components/ConstellationCanvas.astro';
import { profile, site } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Emit Person/WebSite JSON-LD (home page) */
  structuredData?: boolean;
  /** Show the interactive constellation background */
  constellation?: boolean;
}

const {
  title,
  description = site.description,
  image = site.ogImage,
  structuredData = false,
  constellation = true,
} = Astro.props;

const pageTitle = title ? `${title} | ${profile.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: profile.github,
  url: Astro.site?.toString(),
  jobTitle: profile.role,
  description: profile.intro,
  sameAs: profile.socials.map((s) => s.href),
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Declare both schemes up-front so the canvas paints in the right colour (avoids FOUC). -->
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Must run before first paint: apply a pinned scheme and expose the
      // effective scheme on <html data-theme> for icon/canvas logic.
      {
        const pinned = localStorage.getItem('color-scheme');
        if (pinned === 'light' || pinned === 'dark') {
          document.querySelector('meta[name="color-scheme"]').content = pinned;
          // :root declares `color-scheme: light dark` in CSS, so pin it inline too.
          document.documentElement.style.colorScheme = pinned;
        }
        const sys = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = pinned || sys;
      }
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={profile.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      crossorigin
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />

    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(personLd)} />}
  </head>
  <body class="flex min-h-dvh flex-col overflow-x-clip bg-bg font-sans text-fg">
    <a
      href="#main"
      class="fixed left-4 top-4 z-[70] -translate-y-24 rounded-lg bg-fg px-4 py-2 text-sm font-medium text-bg shadow-lg transition-transform focus:translate-y-0"
    >
      본문 바로가기
    </a>

    {constellation && <ConstellationCanvas />}
    <!-- Soft atmospheric tint -->
    <div class="site-tint pointer-events-none fixed inset-0 -z-10" aria-hidden="true"></div>

    <Header />

    <main id="main" tabindex="-1" class="relative z-10 flex-1 outline-none">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style>
  .site-tint {
    background:
      radial-gradient(60rem 40rem at 85% -10%, color-mix(in oklab, var(--accent) 12%, transparent), transparent 70%),
      radial-gradient(50rem 35rem at -10% 30%, color-mix(in oklab, var(--accent-2) 10%, transparent), transparent 70%);
  }
</style>
