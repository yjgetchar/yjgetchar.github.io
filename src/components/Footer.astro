---
import Icon from './Icon.astro';
import { profile } from '../data/profile';

const year = new Date().getFullYear();
---

<footer class="relative z-10 border-t border-line bg-bg/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 py-8 sm:flex-row">
    <div class="flex flex-col items-center gap-1 sm:items-start">
      <span class="text-sm text-muted">&copy; {year} {profile.name}</span>
      <span class="font-mono text-[11px] text-subtle">built with Astro · hosted on GitHub Pages</span>
    </div>
    <div class="flex items-center gap-1 text-muted">
      {
        profile.socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener"
            aria-label={s.label}
            class="inline-flex size-11 items-center justify-center transition-colors hover:text-fg"
          >
            <Icon name={s.icon} class="size-5" />
          </a>
        ))
      }
      {
        profile.email && (
          <a
            href={`mailto:${profile.email}`}
            aria-label="Email"
            class="inline-flex size-11 items-center justify-center transition-colors hover:text-fg"
          >
            <Icon name="mail" class="size-5" />
          </a>
        )
      }
    </div>
  </div>
</footer>
