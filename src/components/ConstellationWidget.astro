---
/**
 * "Tech constellation" — now a contained, touchable bento widget
 * (not a page background). Stack names are drawn as little pills that
 * drift, link up when close, shy away from the pointer and scatter on tap.
 *
 * - Honors prefers-reduced-motion (renders one static frame).
 * - Pauses when off-screen or when the tab is hidden.
 * - Re-reads theme colours on `themechange`.
 */
import { stack } from '../data/profile';
---

<div class="constellation-wrap absolute inset-0" data-labels={JSON.stringify(stack)}>
  <canvas class="constellation block size-full touch-none" aria-hidden="true"></canvas>
</div>

<style>
  /* Probe colours: read back via getComputedStyle so light-dark() resolves. */
  .constellation {
    color: var(--accent);
    border-top-color: var(--surface);
    outline-color: var(--fg);
    column-rule-color: var(--muted);
  }
</style>

<script>
  type RGB = [number, number, number];
  interface Node {
    x: number;
    y: number;
    vx: number;
    vy: number;
    label: string;
    w: number;
  }

  const toRGB = (s: string): RGB => {
    const m = s.match(/[\d.]+/g);
    return m ? [Number(m[0]), Number(m[1]), Number(m[2])] : [128, 128, 128];
  };
  const rgba = (c: RGB, a: number) => `rgba(${c[0]},${c[1]},${c[2]},${a})`;

  document.querySelectorAll<HTMLElement>('.constellation-wrap').forEach((wrap) => {
    const canvas = wrap.querySelector('canvas')!;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const labels: string[] = JSON.parse(wrap.dataset.labels || '[]');
    const pointer = { x: -999, y: -999, active: false };
    let w = 0;
    let h = 0;
    let nodes: Node[] = [];
    let raf = 0;
    let last = 0;
    let visible = true;
    let colors = { accent: [0, 113, 227] as RGB, surface: [255, 255, 255] as RGB, fg: [29, 29, 31] as RGB };

    const font = '600 12px -apple-system, BlinkMacSystemFont, "SF Pro Text", "Pretendard Variable", sans-serif';

    function readColors() {
      const cs = getComputedStyle(canvas);
      colors = { accent: toRGB(cs.color), surface: toRGB(cs.borderTopColor), fg: toRGB(cs.outlineColor) };
    }

    const PILL_H = 26;
    const GAP = 6;
    // Area kept free for the caption badge in the top-left corner
    const reserved = { x: 0, y: 0, w: 210, h: 40 };

    function clamp(n: Node) {
      const hw = n.w / 2;
      n.x = Math.max(hw, Math.min(w - hw, n.x));
      n.y = Math.max(14, Math.min(h - 14, n.y));
    }

    /** Push overlapping pills apart along the axis of least overlap. */
    function separate(strength: number) {
      let moved = false;
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          const ox = (a.w + b.w) / 2 + GAP - Math.abs(a.x - b.x);
          const oy = PILL_H + GAP - Math.abs(a.y - b.y);
          if (ox <= 0 || oy <= 0) continue;
          moved = true;
          if (ox < oy * 2) {
            const s = (ox / 2) * strength * (a.x < b.x ? -1 : 1);
            a.x += s;
            b.x -= s;
          } else {
            const s = (oy / 2) * strength * (a.y < b.y ? -1 : 1);
            a.y += s;
            b.y -= s;
          }
        }
        // Keep out of the caption badge
        const rx = reserved.x + reserved.w + a.w / 2 - a.x;
        const ry = reserved.y + reserved.h + PILL_H / 2 - a.y;
        if (rx > 0 && ry > 0) {
          moved = true;
          if (rx < ry) a.x += rx * strength;
          else a.y += ry * strength;
        }
        clamp(a);
      }
      return moved;
    }

    function build() {
      ctx!.font = font;
      const count = Math.max(6, Math.min(labels.length, Math.round((w * h) / 9000)));
      nodes = labels.slice(0, count).map((label) => {
        const tw = ctx!.measureText(label).width + 20;
        return {
          x: tw / 2 + Math.random() * Math.max(1, w - tw),
          y: 18 + Math.random() * Math.max(1, h - 36),
          vx: (Math.random() - 0.5) * 0.03,
          vy: (Math.random() - 0.5) * 0.03,
          label,
          w: tw,
        };
      });
      for (let k = 0; k < 120 && separate(1); k++);
    }

    function resize() {
      const r = wrap.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = r.width;
      h = r.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      build();
      draw();
    }

    function step(dt: number) {
      for (const n of nodes) {
        if (pointer.active) {
          const dx = n.x - pointer.x;
          const dy = n.y - pointer.y;
          const d = Math.hypot(dx, dy);
          if (d < 90 && d > 0.5) {
            const s = (1 - d / 90) * 0.0025 * dt;
            n.vx += (dx / d) * s;
            n.vy += (dy / d) * s;
          }
        }
        const sp = Math.hypot(n.vx, n.vy);
        if (sp > 0.05) {
          n.vx *= 0.95;
          n.vy *= 0.95;
        }
        n.x += n.vx * dt;
        n.y += n.vy * dt;
        const hw = n.w / 2;
        if (n.x < hw || n.x > w - hw) n.vx *= -1;
        if (n.y < 14 || n.y > h - 14) n.vy *= -1;
        clamp(n);
      }
      // Gentle, continuous de-overlap while drifting
      separate(0.15);
    }

    function draw() {
      ctx!.clearRect(0, 0, w, h);
      const linkD = Math.min(150, Math.max(110, w / 4));

      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const a = nodes[i];
          const b = nodes[j];
          const d = Math.hypot(a.x - b.x, a.y - b.y);
          if (d > linkD) continue;
          ctx!.strokeStyle = rgba(colors.accent, (1 - d / linkD) * 0.35);
          ctx!.lineWidth = 1;
          ctx!.beginPath();
          ctx!.moveTo(a.x, a.y);
          ctx!.lineTo(b.x, b.y);
          ctx!.stroke();
        }
      }

      ctx!.font = font;
      ctx!.textAlign = 'center';
      ctx!.textBaseline = 'middle';
      for (const n of nodes) {
        const near = pointer.active && Math.hypot(n.x - pointer.x, n.y - pointer.y) < 70;
        const x = n.x - n.w / 2;
        const y = n.y - 13;
        ctx!.shadowColor = 'rgba(0,0,0,0.08)';
        ctx!.shadowBlur = 8;
        ctx!.shadowOffsetY = 2;
        ctx!.fillStyle = near ? rgba(colors.accent, 1) : rgba(colors.surface, 0.95);
        ctx!.beginPath();
        ctx!.roundRect(x, y, n.w, 26, 13);
        ctx!.fill();
        ctx!.shadowColor = 'transparent';
        ctx!.fillStyle = near ? '#fff' : rgba(colors.fg, 0.85);
        ctx!.fillText(n.label, n.x, n.y + 0.5);
      }
    }

    function loop(now: number) {
      const dt = Math.min(50, now - last);
      last = now;
      step(dt);
      draw();
      raf = requestAnimationFrame(loop);
    }

    function start() {
      cancelAnimationFrame(raf);
      if (reduceMotion.matches || document.hidden || !visible) {
        draw();
        return;
      }
      last = performance.now();
      raf = requestAnimationFrame(loop);
    }

    // --- events -----------------------------------------------------------
    const tile = wrap.parentElement ?? wrap;
    tile.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      pointer.x = e.clientX - r.left;
      pointer.y = e.clientY - r.top;
      pointer.active = true;
    });
    tile.addEventListener('pointerleave', () => (pointer.active = false));
    tile.addEventListener('pointerdown', (e) => {
      if (reduceMotion.matches) return;
      const r = canvas.getBoundingClientRect();
      const px = e.clientX - r.left;
      const py = e.clientY - r.top;
      for (const n of nodes) {
        const dx = n.x - px;
        const dy = n.y - py;
        const d = Math.hypot(dx, dy) || 1;
        n.vx += (dx / d) * 0.35;
        n.vy += (dy / d) * 0.35;
      }
    });

    new ResizeObserver(() => resize()).observe(wrap);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      start();
    }).observe(wrap);
    document.addEventListener('visibilitychange', start);
    reduceMotion.addEventListener('change', start);
    window.addEventListener('themechange', () => {
      readColors();
      draw();
    });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      readColors();
      draw();
    });

    readColors();
    resize();
    start();
  });
</script>
