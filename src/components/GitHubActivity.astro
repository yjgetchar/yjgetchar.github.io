---
/**
 * GitHub contribution calendar rendered at build time as SVG,
 * sized to fit a bento tile. Hides itself if data can't be fetched.
 */
import { getContributions } from '../lib/github';
import { profile } from '../data/profile';

interface Props {
  /** How many recent weeks to show */
  weeks?: number;
}
const { weeks: maxWeeks = 26 } = Astro.props;

const contrib = await getContributions(profile.github);

type Day = { date: string; count: number; level: number };
const weeks: (Day | null)[][] = [];
if (contrib) {
  const days = contrib.days;
  const firstDow = new Date(`${days[0].date}T00:00:00Z`).getUTCDay();
  const padded: (Day | null)[] = [...Array.from({ length: firstDow }, () => null), ...days];
  for (let i = 0; i < padded.length; i += 7) weeks.push(padded.slice(i, i + 7));
}
const shown = weeks.slice(-maxWeeks);
const recentTotal = shown.flat().reduce((s, d) => s + (d?.count ?? 0), 0);

const cell = 12;
const gap = 4;
const width = shown.length * (cell + gap) - gap;
const height = 7 * (cell + gap) - gap;
const levelOpacity = [0, 0.3, 0.5, 0.75, 1];
---

{
  contrib && (
    <div class="flex h-full flex-col">
      <div class="flex items-baseline justify-between gap-3">
        <p class="eyebrow">GitHub 활동</p>
        <a
          href={`https://github.com/${profile.github}`}
          target="_blank"
          rel="noopener"
          class="relative z-10 text-[12px] text-accent hover:underline"
        >
          @{profile.github}
        </a>
      </div>
      <p class="mt-1 text-[28px] font-bold tracking-tight">
        {recentTotal.toLocaleString('ko-KR')}
        <span class="text-[15px] font-medium text-muted">회 기여 · 최근 {Math.round(maxWeeks / 4.3)}개월</span>
      </p>
      <div class="mt-auto pt-4">
        <svg
          viewBox={`0 0 ${width} ${height}`}
          class="block h-auto w-full"
          role="img"
          aria-label={`최근 ${maxWeeks}주간 GitHub 기여 ${recentTotal}회`}
        >
          {shown.map((wk, wi) =>
            wk.map((day, di) =>
              day ? (
                <rect
                  x={wi * (cell + gap)}
                  y={di * (cell + gap)}
                  width={cell}
                  height={cell}
                  rx="3.5"
                  class={day.level === 0 ? 'fill-fg/[0.07]' : 'fill-[#30d158]'}
                  fill-opacity={day.level === 0 ? undefined : levelOpacity[day.level]}
                >
                  <title>{`${day.date} · ${day.count}회`}</title>
                </rect>
              ) : null,
            ),
          )}
        </svg>
      </div>
    </div>
  )
}
