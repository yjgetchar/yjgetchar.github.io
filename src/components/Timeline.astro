---
import { timeline } from '../data/profile';
---

<ol class="divide-y divide-line">
  {
    timeline.map((item) => (
      <li class="grid gap-1 py-5 first:pt-0 last:pb-0 sm:grid-cols-[160px_1fr] sm:gap-6">
        <p class="text-[13px] font-medium text-subtle sm:pt-0.5">{item.period}</p>
        <div>
          <h3 class="flex flex-wrap items-center gap-2 text-[17px] font-semibold tracking-tight">
            {item.title}
            <span class:list={['chip', item.kind === 'edu' ? 'bg-t-lavender' : 'bg-t-blue']}>{item.org}</span>
          </h3>
          <p class="mt-1.5 text-[15px] leading-relaxed text-muted">{item.body}</p>
        </div>
      </li>
    ))
  }
</ol>
