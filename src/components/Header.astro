---
import Icon from './Icon.astro';
import { nav, profile } from '../data/profile';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => !href.includes('#') && (path === href || path.startsWith(`${href}/`));
---

<!-- Apple-style translucent global nav -->
<header class="sticky top-0 z-50 border-b border-line bg-bg/75 backdrop-blur-xl backdrop-saturate-150">
  <nav class="mx-auto flex h-13 max-w-[1120px] items-center justify-between px-5" aria-label="주 메뉴">
    <a href="/" class="inline-flex min-h-11 items-center gap-2 text-[15px] font-semibold tracking-tight">
      <img src="/favicon.svg" alt="" width="22" height="22" class="size-[22px] rounded-md" />
      {profile.name}
    </a>

    <!-- Desktop -->
    <div class="hidden items-center gap-1 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-full px-3.5 py-1.5 text-[13px] transition-colors',
              isActive(item.href) ? 'bg-fg/[0.07] font-medium text-fg' : 'text-muted hover:text-fg',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <button
        type="button"
        data-theme-toggle
        class="ml-1 inline-flex size-10 cursor-pointer items-center justify-center rounded-full text-muted transition-colors hover:bg-fg/[0.06] hover:text-fg"
        aria-label="다크 모드 전환"
      >
        <span class="theme-icon-moon"><Icon name="moon" class="size-[18px]" /></span>
        <span class="theme-icon-sun"><Icon name="sun" class="size-[18px]" /></span>
      </button>
    </div>

    <!-- Mobile -->
    <div class="flex items-center gap-1 md:hidden">
      <button
        type="button"
        data-theme-toggle
        class="inline-flex size-11 cursor-pointer items-center justify-center rounded-full text-muted"
        aria-label="다크 모드 전환"
      >
        <span class="theme-icon-moon"><Icon name="moon" class="size-5" /></span>
        <span class="theme-icon-sun"><Icon name="sun" class="size-5" /></span>
      </button>
      <button
        type="button"
        popovertarget="mobile-menu"
        class="inline-flex size-11 cursor-pointer items-center justify-center rounded-full text-muted"
        aria-label="메뉴 열기"
      >
        <Icon name="menu" class="size-6" />
      </button>
    </div>
  </nav>

  <!-- Popover gives us light-dismiss, Esc-to-close and focus handling for free -->
  <div id="mobile-menu" popover class="mobile-menu tile p-2 md:hidden">
    <ul class="flex flex-col">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="flex min-h-12 items-center rounded-2xl px-4 text-[17px] font-medium transition-colors hover:bg-fg/[0.05]"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  .mobile-menu {
    position: fixed;
    inset: 3.75rem 0.75rem auto 0.75rem;
    margin: 0;
    width: auto;
    color: var(--fg);
    opacity: 0;
    translate: 0 -8px;
    transition:
      opacity 200ms ease,
      translate 200ms ease,
      display 200ms allow-discrete,
      overlay 200ms allow-discrete;
  }
  .mobile-menu:popover-open {
    opacity: 1;
    translate: 0 0;
  }
  @starting-style {
    .mobile-menu:popover-open {
      opacity: 0;
      translate: 0 -8px;
    }
  }

  /* Show the icon for the scheme you'd switch TO */
  .theme-icon-sun {
    display: none;
  }
  :global(html[data-theme='dark']) .theme-icon-sun {
    display: inline-flex;
  }
  :global(html[data-theme='dark']) .theme-icon-moon {
    display: none;
  }
</style>

<script>
  // Two-state toggle per modern dark-mode guidance:
  //   (1) follow system  ⇄  (2) pin the opposite scheme.
  const meta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]')!;
  const mq = matchMedia('(prefers-color-scheme: dark)');
  const sys = () => (mq.matches ? 'dark' : 'light');

  function apply(pinned: string | null) {
    if (pinned) {
      localStorage.setItem('color-scheme', pinned);
      meta.content = pinned;
    } else {
      localStorage.removeItem('color-scheme');
      meta.content = 'light dark';
    }
    document.documentElement.style.colorScheme = pinned ?? '';
    document.documentElement.dataset.theme = pinned ?? sys();
    window.dispatchEvent(new CustomEvent('themechange'));
  }

  document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const current = document.documentElement.dataset.theme;
      const next = current === 'dark' ? 'light' : 'dark';
      apply(next === sys() ? null : next);
    });
  });

  // Keep the effective scheme in sync when the OS theme changes.
  mq.addEventListener('change', () => {
    if (!localStorage.getItem('color-scheme')) apply(null);
  });

  // Close the mobile menu after picking an in-page link.
  const menu = document.getElementById('mobile-menu');
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.hidePopover()));
</script>
