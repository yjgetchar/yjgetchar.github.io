---
/**
 * Interactive Background: Metaball Energy Field + Deep Space Nodes
 *
 * Combines:
 * 1. Metaball Energy Field: 3~6 soft, organic radial energy blobs slowly drifting and blending
 * 2. Deep Space Nodes: 100~200 depth-aware particles with z-depth parallax and subtle neural filaments
 * 3. Interactions: subtle mouse parallax, cursor movement wave, and gentle click/tap ripples
 * 4. Readability: scroll dampening (100% on Hero down to 25% on footer) preserving full text contrast
 *
 * Configurable parameters are centralized in `EFFECT_CONFIG` below.
 */
---

<canvas
  id="interactive-bg"
  class="pointer-events-none fixed inset-0 z-0 h-full w-full"
  aria-hidden="true"
></canvas>

<script>
  /**
   * =======================================================================
   * EFFECT_CONFIG — 쉽게 조절할 수 있는 단일 파라미터 제어판
   * =======================================================================
   */
  const EFFECT_CONFIG = {
    // [Particles / Nodes]
    particleCount: 160,          // 데스크톱 기본 노드 개수
    particleSpeed: 0.3,           // 노드 부유 속도 (기본 0.3: 매우 부드럽고 차분함)
    parallaxStrength: 32,        // 마우스 이동 시 Z=1.0 노드의 최대 이동 거리(px)
    nodeBaseSize: 1.6,           // 노드 기본 크기 계수
    connectDistance: 70,         // 노드 간 신경망 미세 연결선 최대 거리(px)
    connectOpacity: 0.12,        // 연결선 최대 투명도

    // [Metaball Energy Blobs]
    blobCount: 4,                // 화면 뒤쪽을 유영하는 에너지 블롭 개수 (3~6 권장)
    blobSize: 340,               // 블롭 기본 반경(px)
    blobSpeed: 0.22,             // 블롭 이동 속도 (느리고 안정적)
    blobIntensity: 0.14,         // 블롭 중심부 최대 밝기/투명도 (본문 가독성 보호)
    blobBlendMode: 'screen' as GlobalCompositeOperation, // 'screen' 또는 'lighter'

    // [Interactions]
    rippleStrength: 0.35,        // 클릭/터치 시 발생하는 에너지 파문의 초기 강도
    rippleDuration: 1100,        // 파문 지속 시간(ms)
    rippleMaxRadius: 180,        // 파문 최대 확산 반경(px)
    mouseInertia: 0.05,          // 마우스 반응 부드러움 계수 (lerp)
    velocityWaveFactor: 0.18,    // 마우스 급이동 시 주변 노드 미세 흔들림 계수

    // [Overall / Scroll Dampening]
    backgroundOpacity: 0.95,     // 전체 이펙트 마스터 투명도
    heroDampeningHeight: 500,    // Hero 영역 높이 기준 (이 이상 스크롤 시 감쇄 시작)
    minScrollOpacity: 0.25,      // 하단 스크롤(Experience, Projects, Contact) 시 최소 유지 투명도

    // [Colors] - Dark-first Zinc & Emerald 테마 매칭
    colors: {
      dark: {
        blobs: [
          { r: 16, g: 185, b: 129 }, // Emerald (#10b981)
          { r: 5, g: 150, b: 105 },  // Deep Emerald (#059669)
          { r: 20, g: 184, b: 166 }, // Cyan-Teal (#14b8a6)
          { r: 45, g: 212, b: 191 }, // Soft Aquamarine (#2dd4bf)
        ],
        node: { r: 167, g: 243, b: 208 },   // Light Emerald Tint
        edge: { r: 52, g: 211, b: 153 },    // Emerald Filament
        ripple: { r: 52, g: 211, b: 153 },  // Ripple Wave
      },
      light: {
        blobs: [
          { r: 16, g: 185, b: 129 },
          { r: 5, g: 150, b: 105 },
          { r: 20, g: 184, b: 166 },
          { r: 13, g: 148, b: 136 },
        ],
        node: { r: 5, g: 150, b: 105 },
        edge: { r: 16, g: 185, b: 129 },
        ripple: { r: 5, g: 150, b: 105 },
      },
    },

    // [Performance & Mobile]
    mobileBreakpoint: 768,       // 모바일 분기 기준 너비(px)
    mobileParticleMultiplier: 0.42, // 모바일 노드 개수 비율 (약 65개)
    mobileMaxDpr: 1.5,           // 모바일 최대 DPR (배터리 및 발열 방지)
    desktopMaxDpr: 2.0,          // 데스크톱 최대 DPR
  };

  /**
   * Node Class (Deep Space Particle)
   */
  interface NodeParticle {
    x: number;
    y: number;
    vx: number;
    vy: number;
    z: number;              // 0.1 (far) ~ 1.0 (near)
    size: number;
    baseOpacity: number;
    impulseX: number;
    impulseY: number;
  }

  /**
   * Energy Blob Class (Metaball Field Component)
   */
  interface EnergyBlob {
    x: number;
    y: number;
    radius: number;
    angle: number;
    angleSpeed: number;
    orbitX: number;
    orbitY: number;
    centerX: number;
    centerY: number;
    color: { r: number; g: number; b: number };
  }

  /**
   * Ripple Wave Class
   */
  interface Ripple {
    x: number;
    y: number;
    startTime: number;
    maxRadius: number;
  }

  function initBackground() {
    const canvas = document.getElementById('interactive-bg') as HTMLCanvasElement | null;
    if (!canvas) return;

    const rawCtx = canvas.getContext('2d', { alpha: true });
    if (!rawCtx) return;
    const ctx: CanvasRenderingContext2D = rawCtx;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let isMobile = false;

    // State
    let particles: NodeParticle[] = [];
    let blobs: EnergyBlob[] = [];
    let ripples: Ripple[] = [];
    let mouse = { x: 0, y: 0, normX: 0, normY: 0, smoothX: 0, smoothY: 0, lastX: 0, lastY: 0, speed: 0 };
    let scrollDampening = 1.0;
    let isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let isTabVisible = !document.hidden;
    let animId = 0;

    const isLightMode = () => document.documentElement.dataset.theme === 'light';
    const getPalette = () => (isLightMode() ? EFFECT_CONFIG.colors.light : EFFECT_CONFIG.colors.dark);

    // Setup viewport & sizing
    function resize() {
      if (!canvas) return;
      width = window.innerWidth;
      height = window.innerHeight;
      isMobile = width < EFFECT_CONFIG.mobileBreakpoint;
      const maxDpr = isMobile ? EFFECT_CONFIG.mobileMaxDpr : EFFECT_CONFIG.desktopMaxDpr;
      dpr = Math.min(window.devicePixelRatio || 1, maxDpr);

      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      initBlobs();
      initParticles();
    }

    // Initialize Energy Blobs
    function initBlobs() {
      blobs = [];
      const palette = getPalette();
      const count = EFFECT_CONFIG.blobCount;

      for (let i = 0; i < count; i++) {
        const color = palette.blobs[i % palette.blobs.length];
        const rx = EFFECT_CONFIG.blobSize * (0.85 + Math.random() * 0.3);
        const cx = (width * (i + 0.5)) / count + (Math.random() - 0.5) * 80;
        const cy = height * 0.35 + (Math.random() - 0.5) * (height * 0.4);

        blobs.push({
          x: cx,
          y: cy,
          centerX: cx,
          centerY: cy,
          radius: rx,
          angle: Math.random() * Math.PI * 2,
          angleSpeed: (Math.random() * 0.4 + 0.6) * 0.006 * (Math.random() < 0.5 ? 1 : -1) * (EFFECT_CONFIG.blobSpeed / 0.2),
          orbitX: width * 0.14 + Math.random() * 40,
          orbitY: height * 0.12 + Math.random() * 30,
          color,
        });
      }
    }

    // Initialize Deep Space Nodes
    function initParticles() {
      particles = [];
      const count = Math.floor(
        EFFECT_CONFIG.particleCount * (isMobile ? EFFECT_CONFIG.mobileParticleMultiplier : 1.0)
      );

      for (let i = 0; i < count; i++) {
        const z = 0.1 + Math.pow(Math.random(), 1.3) * 0.9;
        const baseSpeed = EFFECT_CONFIG.particleSpeed * (0.35 + z * 0.65);
        const angle = Math.random() * Math.PI * 2;

        particles.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: Math.cos(angle) * baseSpeed,
          vy: Math.sin(angle) * baseSpeed,
          z,
          size: (0.7 + z * 1.6) * EFFECT_CONFIG.nodeBaseSize,
          baseOpacity: 0.14 + z * 0.58,
          impulseX: 0,
          impulseY: 0,
        });
      }
    }

    // Calculate scroll dampening factor
    function updateScrollDampening() {
      const scrollY = window.scrollY;
      const heroH = EFFECT_CONFIG.heroDampeningHeight;
      const fullH = document.documentElement.scrollHeight - window.innerHeight;

      if (scrollY <= 80) {
        scrollDampening = 1.0;
      } else {
        const progress = Math.min(1.0, (scrollY - 80) / Math.max(heroH, fullH * 0.6));
        scrollDampening = 1.0 - progress * (1.0 - EFFECT_CONFIG.minScrollOpacity);
      }
    }

    // Mouse & Touch Handlers
    function onPointerMove(e: MouseEvent) {
      const x = e.clientX;
      const y = e.clientY;
      mouse.x = x;
      mouse.y = y;
      mouse.normX = (x / width) * 2 - 1;
      mouse.normY = (y / height) * 2 - 1;

      const dx = x - mouse.lastX;
      const dy = y - mouse.lastY;
      mouse.speed = Math.sqrt(dx * dx + dy * dy);
      mouse.lastX = x;
      mouse.lastY = y;

      if (mouse.speed > 8) {
        const factor = Math.min(3.0, mouse.speed * 0.08) * EFFECT_CONFIG.velocityWaveFactor;
        for (let i = 0; i < particles.length; i++) {
          const p = particles[i];
          if (p.z > 0.65) {
            const distSq = (p.x - x) * (p.x - x) + (p.y - y) * (p.y - y);
            if (distSq < 180 * 180) {
              const dist = Math.sqrt(distSq) || 1;
              const push = (1 - dist / 180) * factor * p.z;
              p.impulseX += (dx / dist) * push;
              p.impulseY += (dy / dist) * push;
            }
          }
        }
      }
    }

    function triggerRipple(x: number, y: number) {
      ripples.push({
        x,
        y,
        startTime: performance.now(),
        maxRadius: EFFECT_CONFIG.rippleMaxRadius * (isMobile ? 0.8 : 1.0),
      });
      if (ripples.length > 5) ripples.shift();
    }

    // Main Animation Loop
    function render(time: number) {
      if (!isTabVisible) {
        animId = requestAnimationFrame(render);
        return;
      }

      mouse.smoothX += (mouse.normX - mouse.smoothX) * EFFECT_CONFIG.mouseInertia;
      mouse.smoothY += (mouse.normY - mouse.smoothY) * EFFECT_CONFIG.mouseInertia;

      ctx.clearRect(0, 0, width, height);

      const palette = getPalette();
      const masterAlpha = EFFECT_CONFIG.backgroundOpacity * scrollDampening;

      // -------------------------------------------------------------
      // 1. Metaball Energy Field Render
      // -------------------------------------------------------------
      ctx.save();
      ctx.globalCompositeOperation = isLightMode() ? 'source-over' : EFFECT_CONFIG.blobBlendMode;

      for (let i = 0; i < blobs.length; i++) {
        const b = blobs[i];
        if (!isReducedMotion) {
          b.angle += b.angleSpeed;
        }

        const targetX = b.centerX + Math.cos(b.angle) * b.orbitX + mouse.smoothX * 25;
        const targetY = b.centerY + Math.sin(b.angle * 0.85) * b.orbitY + mouse.smoothY * 20;
        b.x += (targetX - b.x) * 0.04;
        b.y += (targetY - b.y) * 0.04;

        const effectiveRadius = b.radius * (isMobile ? 0.75 : 1.0);
        const centerAlpha = EFFECT_CONFIG.blobIntensity * masterAlpha;

        const grad = ctx.createRadialGradient(b.x, b.y, 0, b.x, b.y, effectiveRadius);
        grad.addColorStop(0, `rgba(${b.color.r}, ${b.color.g}, ${b.color.b}, ${centerAlpha})`);
        grad.addColorStop(0.35, `rgba(${b.color.r}, ${b.color.g}, ${b.color.b}, ${centerAlpha * 0.55})`);
        grad.addColorStop(0.7, `rgba(${b.color.r}, ${b.color.g}, ${b.color.b}, ${centerAlpha * 0.18})`);
        grad.addColorStop(1, `rgba(${b.color.r}, ${b.color.g}, ${b.color.b}, 0)`);

        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.arc(b.x, b.y, effectiveRadius, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();

      // -------------------------------------------------------------
      // 2. Ripples (Expanding Energy Waves)
      // -------------------------------------------------------------
      if (ripples.length > 0) {
        ctx.save();
        for (let i = ripples.length - 1; i >= 0; i--) {
          const r = ripples[i];
          const elapsed = time - r.startTime;
          const progress = Math.min(1.0, elapsed / EFFECT_CONFIG.rippleDuration);

          if (progress >= 1.0) {
            ripples.splice(i, 1);
            continue;
          }

          const currentRadius = r.maxRadius * (1 - Math.pow(1 - progress, 2.5));
          const waveAlpha = EFFECT_CONFIG.rippleStrength * (1 - progress) * masterAlpha;

          ctx.beginPath();
          ctx.arc(r.x, r.y, currentRadius, 0, Math.PI * 2);
          ctx.strokeStyle = `rgba(${palette.ripple.r}, ${palette.ripple.g}, ${palette.ripple.b}, ${waveAlpha})`;
          ctx.lineWidth = 1.6 * (1 - progress * 0.5);
          ctx.stroke();

          ctx.beginPath();
          ctx.arc(r.x, r.y, currentRadius * 0.85, 0, Math.PI * 2);
          ctx.strokeStyle = `rgba(${palette.ripple.r}, ${palette.ripple.g}, ${palette.ripple.b}, ${waveAlpha * 0.4})`;
          ctx.lineWidth = 1.0;
          ctx.stroke();
        }
        ctx.restore();
      }

      // -------------------------------------------------------------
      // 3. Deep Space Nodes & Subtle Neural Connections
      // -------------------------------------------------------------
      const maxParallax = EFFECT_CONFIG.parallaxStrength;
      const renderCoords: { rx: number; ry: number; z: number; size: number; opacity: number }[] = [];

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];

        if (!isReducedMotion) {
          p.x += p.vx;
          p.y += p.vy;

          p.impulseX *= 0.92;
          p.impulseY *= 0.92;

          if (p.x < -30) p.x = width + 30;
          else if (p.x > width + 30) p.x = -30;
          if (p.y < -30) p.y = height + 30;
          else if (p.y > height + 30) p.y = -30;
        }

        const zWeight = p.z * p.z;
        const rx = p.x + mouse.smoothX * maxParallax * zWeight + p.impulseX;
        const ry = p.y + mouse.smoothY * maxParallax * zWeight + p.impulseY;
        const finalAlpha = p.baseOpacity * masterAlpha;

        renderCoords.push({ rx, ry, z: p.z, size: p.size, opacity: finalAlpha });
      }

      // 3a. Subtle neural filaments
      if (!isMobile && masterAlpha > 0.3) {
        ctx.save();
        const maxDist = EFFECT_CONFIG.connectDistance;
        const maxDistSq = maxDist * maxDist;

        for (let i = 0; i < renderCoords.length; i++) {
          const a = renderCoords[i];
          if (a.z < 0.35) continue;

          for (let j = i + 1; j < renderCoords.length; j++) {
            const b = renderCoords[j];
            if (Math.abs(a.z - b.z) > 0.28) continue;

            const dx = a.rx - b.rx;
            const dy = a.ry - b.ry;
            const dSq = dx * dx + dy * dy;

            if (dSq < maxDistSq) {
              const d = Math.sqrt(dSq);
              const edgeAlpha = (1 - d / maxDist) * EFFECT_CONFIG.connectOpacity * Math.min(a.z, b.z) * masterAlpha;
              ctx.beginPath();
              ctx.moveTo(a.rx, a.ry);
              ctx.lineTo(b.rx, b.ry);
              ctx.strokeStyle = `rgba(${palette.edge.r}, ${palette.edge.g}, ${palette.edge.b}, ${edgeAlpha})`;
              ctx.lineWidth = 0.7;
              ctx.stroke();
            }
          }
        }
        ctx.restore();
      }

      // 3b. Draw Node Particles
      ctx.save();
      for (let i = 0; i < renderCoords.length; i++) {
        const c = renderCoords[i];
        ctx.beginPath();
        ctx.arc(c.rx, c.ry, c.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${palette.node.r}, ${palette.node.g}, ${palette.node.b}, ${c.opacity})`;
        ctx.fill();

        if (c.z > 0.75 && masterAlpha > 0.4) {
          ctx.beginPath();
          ctx.arc(c.rx, c.ry, c.size * 2.2, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${palette.node.r}, ${palette.node.g}, ${palette.node.b}, ${c.opacity * 0.22})`;
          ctx.fill();
        }
      }
      ctx.restore();

      animId = requestAnimationFrame(render);
    }

    // Attach Event Listeners
    let resizeTimer: number;
    function handleResize() {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        resize();
        updateScrollDampening();
      }, 100);
    }

    window.addEventListener('resize', handleResize, { passive: true });
    window.addEventListener('scroll', updateScrollDampening, { passive: true });
    window.addEventListener('mousemove', onPointerMove, { passive: true });

    // Click / Tap Ripple
    window.addEventListener(
      'pointerdown',
      (e) => {
        triggerRipple(e.clientX, e.clientY);
      },
      { passive: true }
    );

    // Visibility management
    document.addEventListener('visibilitychange', () => {
      isTabVisible = !document.hidden;
      if (isTabVisible && !animId) {
        animId = requestAnimationFrame(render);
      }
    });

    // Theme mutation observer
    const observer = new MutationObserver(() => {
      initBlobs();
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    // Reduced motion preference
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    motionQuery.addEventListener('change', (e) => {
      isReducedMotion = e.matches;
    });

    // Initial kick-off
    resize();
    updateScrollDampening();
    animId = requestAnimationFrame(render);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBackground, { once: true });
  } else {
    initBackground();
  }
</script>
