---
/**
 * Avatar + name + role + location + social buttons.
 * Used inside the desktop sidebar and at the top of the mobile home page.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import avatar from '../assets/profile/avatar.jpg';
import { profile } from '../data/profile';

interface Props {
  /** Heading level for the name: the home page uses h1 on mobile */
  as?: 'h1' | 'p';
  eager?: boolean;
}
const { as: Tag = 'p', eager = false } = Astro.props;
---

<div class="flex flex-col items-center text-center lg:items-start lg:text-left">
  <Image
    src={avatar}
    alt={`${profile.name} 프로필 사진`}
    width={176}
    height={176}
    densities={[1, 2]}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    class="size-28 rounded-full object-cover ring-1 ring-line ring-offset-4 ring-offset-bg lg:size-24"
  />
  <Tag class="mt-5 text-[28px] leading-tight font-bold tracking-[-0.03em]">{profile.name}</Tag>
  <p class="mt-1 text-[15px] font-medium text-accent">{profile.role}</p>
  <p class="mt-3 max-w-xs text-[15px] leading-relaxed text-muted">{profile.tagline}</p>
  <p class="mt-3 inline-flex items-center gap-2 text-[13px] text-subtle">
    <span class="live-dot" aria-hidden="true"></span>
    {profile.location}
  </p>
  <div class="mt-6 flex w-full flex-wrap justify-center gap-2 lg:justify-start">
    {
      profile.socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener" class="btn-secondary flex-1 lg:flex-none">
          <Icon name={s.icon} class="size-4" /> {s.label}
        </a>
      ))
    }
  </div>
</div>
