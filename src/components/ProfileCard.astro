---
/**
 * Avatar + name + role + location + social buttons.
 * Used inside the desktop sidebar and at the top of the mobile home page.
 * Clicking the avatar flips it between the 3D character and the real photo.
 */
import Avatar from './Avatar.astro';
import Icon from './Icon.astro';
import { profile } from '../data/profile';

interface Props {
  /** Heading level for the name: the home page uses h1 on mobile */
  as?: 'h1' | 'p';
  eager?: boolean;
}
const { as: Tag = 'p', eager = false } = Astro.props;
---

<div class="flex flex-col items-center text-center lg:items-start lg:text-left">
  <button
    type="button"
    class="avatar-toggle group relative cursor-pointer rounded-full ring-1 ring-line ring-offset-4 ring-offset-bg transition-shadow hover:ring-accent-bg/60 focus-visible:outline-2 focus-visible:outline-offset-8 focus-visible:outline-accent-bg"
    data-avatar-toggle
    aria-pressed="false"
    aria-label={`${profile.name} 실사 사진 보기`}
    title="클릭하면 사진이 바뀌어요"
  >
    <Avatar size={176} eager={eager} class="size-28 lg:size-24" />
    <span
      class="absolute -right-1 -bottom-1 grid size-8 place-items-center rounded-full border border-line bg-surface text-muted shadow-sm transition-colors group-hover:text-accent"
      aria-hidden="true"
    >
      <svg class="size-4 transition-transform duration-500 group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12a9 9 0 0 1-15.36 6.36L3 16"></path><path d="M3 21v-5h5"></path>
        <path d="M3 12a9 9 0 0 1 15.36-6.36L21 8"></path><path d="M21 3v5h-5"></path>
      </svg>
    </span>
  </button>
  <Tag class="mt-5 text-[28px] leading-tight font-bold tracking-[-0.03em]">{profile.name}</Tag>
  <p class="mt-1 text-[15px] font-medium text-accent">{profile.role}</p>
  <p class="mt-3 max-w-xs text-[15px] leading-relaxed text-muted">{profile.tagline}</p>
  <p class="mt-3 inline-flex items-center gap-2 text-[13px] text-subtle">
    <span class="live-dot" aria-hidden="true"></span>
    {profile.location}
  </p>
  <div class="mt-6 flex w-full flex-wrap justify-center gap-2 lg:justify-start">
    {
      profile.socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener" class="btn-secondary flex-1 lg:flex-none">
          <Icon name={s.icon} class="size-4" /> {s.label}
        </a>
      ))
    }
  </div>
</div>

<script>
  // One state for the whole page: every avatar (sidebar, mobile card, top bar, Ask AI) flips together.
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-avatar-toggle]');
  toggles.forEach((btn) =>
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const showPhoto = root.dataset.avatar !== 'photo';
      if (showPhoto) root.dataset.avatar = 'photo';
      else delete root.dataset.avatar;
      toggles.forEach((t) => t.setAttribute('aria-pressed', String(showPhoto)));
    }),
  );
</script>
