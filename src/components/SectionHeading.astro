---
interface Props {
  index?: number;
  eyebrow: string;
  title: string;
  id?: string;
}
const { index, eyebrow, title, id } = Astro.props;
const num = index !== undefined ? String(index).padStart(2, '0') : undefined;
---

<div class="mb-2 font-mono text-[11px] font-medium tracking-[0.2em] text-subtle uppercase">
  {num && <span class="text-accent">{num}</span>}
  {num && ' — '}
  {eyebrow}
</div>
<div class="mb-8 flex items-center gap-4">
  <h2 id={id} class="font-heading text-2xl font-semibold">{title}</h2>
  <div class="h-px flex-1 bg-gradient-to-r from-line to-transparent" aria-hidden="true"></div>
</div>
