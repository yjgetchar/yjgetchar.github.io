---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { getRepo } from '../lib/github';
import { tintBg } from '../data/profile';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Eager-load covers that are likely above the fold */
  eager?: boolean;
}
const { project, eager = false } = Astro.props;
const { title, summary, tags, cover, tint, repo, status } = project.data;
const info = repo ? await getRepo(repo) : null;
---

<!-- Pinterest-style pin: the whole pin is one link -->
<article class="pin group">
  <a href={`/projects/${project.id}`} class="block rounded-[26px] focus-visible:outline-offset-4">
    <div class:list={['relative overflow-hidden rounded-[26px]', tintBg[tint]]}>
      <Image
        src={cover}
        alt=""
        widths={[400, 700]}
        sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
        loading={eager ? 'eager' : 'lazy'}
        class="h-auto w-full transition-transform duration-700 ease-[cubic-bezier(0.2,0.8,0.2,1)] group-hover:scale-[1.04]"
      />
      <!-- Hover veil + CTA, like Pinterest's overlay -->
      <div
        class="pointer-events-none absolute inset-0 bg-black/0 transition-colors duration-300 group-hover:bg-black/25"
        aria-hidden="true"
      >
      </div>
      <span
        class="absolute top-3 left-3 rounded-full bg-white/90 px-2.5 py-1 text-[11px] font-semibold text-[#1d1d1f] shadow-sm backdrop-blur"
      >
        {status}
      </span>
      <span
        class="absolute right-3 bottom-3 inline-flex translate-y-2 items-center gap-1 rounded-full bg-white px-3.5 py-2 text-[13px] font-semibold text-[#1d1d1f] opacity-0 shadow-md transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100"
        aria-hidden="true"
      >
        자세히 보기 <Icon name="chevron" class="size-3.5" />
      </span>
    </div>

    <div class="px-1.5 pt-3.5">
      <div class="flex items-start justify-between gap-3">
        <h3 class="text-[17px] leading-snug font-semibold tracking-tight">{title}</h3>
        {
          info && (
            <span class="mt-0.5 inline-flex shrink-0 items-center gap-0.5 text-[12px] text-subtle">
              <Icon name="star" class="size-3" />
              {info.stargazers_count}
            </span>
          )
        }
      </div>
      <p class="mt-1 line-clamp-2 text-[14px] leading-relaxed text-muted">{summary}</p>
      <div class="mt-2.5 flex flex-wrap gap-1.5">
        {tags.slice(0, 3).map((t) => <span class="chip">{t}</span>)}
      </div>
    </div>
  </a>
</article>
