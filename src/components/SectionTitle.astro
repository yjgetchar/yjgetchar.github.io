---
/**
 * Section heading for the content column, with an optional "더 보기 ›" link on the right.
 */
import Icon from './Icon.astro';

interface Props {
  title: string;
  id?: string;
  /** Small muted line under the title */
  sub?: string;
  href?: string;
  linkLabel?: string;
}
const { title, id, sub, href, linkLabel = '모두 보기' } = Astro.props;
---

<div class="mb-6 flex items-end justify-between gap-4">
  <div>
    <h2 id={id} class="section-title">{title}</h2>
    {sub && <p class="mt-1 text-[14px] text-subtle">{sub}</p>}
  </div>
  {
    href && (
      <a href={href} class="link-more shrink-0">
        {linkLabel} <Icon name="chevron" class="size-4" />
      </a>
    )
  }
</div>
