---
/**
 * Project grid card (refact0r-style): cover, title, summary, tags; glows on hover.
 * The whole card is one link to the detail page.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { getRepo } from '../lib/github';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Eager-load covers that are likely above the fold */
  eager?: boolean;
}
const { project, eager = false } = Astro.props;
const { title, summary, tags, cover, repo, demo, status } = project.data;
const info = repo ? await getRepo(repo) : null;
---

<article class="card glow-card group overflow-hidden">
  <a href={`/projects/${project.id}`} class="flex h-full flex-col rounded-[20px] focus-visible:outline-offset-4">
    <div class="relative aspect-[16/10] overflow-hidden border-b border-line bg-surface-2">
      <Image
        src={cover}
        alt=""
        widths={[420, 720]}
        sizes="(min-width: 1280px) 400px, (min-width: 640px) 50vw, 100vw"
        loading={eager ? 'eager' : 'lazy'}
        class="size-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.2,0.8,0.2,1)] group-hover:scale-[1.04]"
      />
      <span
        class="absolute top-3 left-3 rounded-full bg-black/60 px-2.5 py-1 text-[11px] font-semibold text-white backdrop-blur"
      >
        {status}
      </span>
    </div>

    <div class="flex flex-1 flex-col p-5">
      <div class="flex items-start justify-between gap-3">
        <h3 class="text-[17px] leading-snug font-semibold tracking-tight group-hover:text-accent">{title}</h3>
        <span class="mt-0.5 inline-flex shrink-0 items-center gap-2 text-subtle">
          {
            info && (
              <span class="inline-flex items-center gap-0.5 text-[12px]">
                <Icon name="star" class="size-3" />
                {info.stargazers_count}
              </span>
            )
          }
          {repo && <Icon name="github" class="size-4" />}
          {demo && <Icon name="external" class="size-4" />}
        </span>
      </div>
      <p class="mt-1.5 line-clamp-2 text-[14px] leading-relaxed text-muted">{summary}</p>
      <div class="mt-auto flex flex-wrap gap-1.5 pt-4">
        {tags.slice(0, 4).map((t) => <span class="chip">{t}</span>)}
      </div>
    </div>
  </a>
</article>
