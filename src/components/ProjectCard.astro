---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { getRepo } from '../lib/github';

interface Props {
  project: CollectionEntry<'projects'>;
  size?: 'md' | 'lg';
}
const { project, size = 'lg' } = Astro.props;
const { title, summary, tags, icon, repo, demo, status } = project.data;
const info = repo ? await getRepo(repo) : null;

const statusTone: Record<string, string> = {
  Live: 'text-accent border-accent/30 bg-accent-soft',
  Released: 'text-accent-2 border-accent-2/30 bg-accent-2/10',
  'In Progress': 'text-amber-600 dark:text-amber-400 border-amber-500/30 bg-amber-500/10',
  Private: 'text-muted border-line bg-fg/5',
  Archived: 'text-subtle border-line bg-fg/5',
};
---

<article
  class:list={[
    'glass lift group relative flex min-w-0 flex-col rounded-2xl',
    size === 'lg' ? 'p-6 sm:p-7' : 'p-5',
  ]}
>
  <div class="flex items-start justify-between gap-3">
    <div class="flex min-w-0 items-center gap-2.5">
      <span class="text-xl leading-none select-none" aria-hidden="true">{icon}</span>
      <h3 class="min-w-0 font-heading text-xl font-semibold transition-colors group-hover:text-accent">
        <!-- Stretched link: the whole card is clickable without nesting anchors -->
        <a href={`/projects/${project.id}`} class="after:absolute after:inset-0 after:rounded-2xl after:content-['']">
          {title}
        </a>
      </h3>
      <Icon
        name="chevron"
        class="size-4 shrink-0 text-subtle transition-[color,transform] group-hover:translate-x-0.5 group-hover:text-accent"
      />
    </div>
    <span class:list={['shrink-0 rounded-full border px-2.5 py-0.5 text-xs font-medium', statusTone[status]]}>
      {status}
    </span>
  </div>

  <p class="mt-2.5 text-sm leading-relaxed text-muted">{summary}</p>

  <div class="mt-4 flex flex-wrap gap-1.5">
    {tags.slice(0, size === 'lg' ? 5 : 4).map((t) => <span class="tag">{t}</span>)}
  </div>

  {
    (repo || demo) && (
      <div class="relative z-10 mt-auto flex flex-wrap items-center gap-4 pt-5 font-mono text-xs">
        {repo && (
          <a
            href={info?.html_url ?? `https://github.com/${repo}`}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 text-muted transition-colors hover:text-fg"
          >
            <Icon name="github" class="size-3.5" />
            GitHub
            {info && (
              <span class="inline-flex items-center gap-0.5 text-subtle">
                <Icon name="star" class="size-3" />
                {info.stargazers_count}
              </span>
            )}
          </a>
        )}
        {demo && (
          <a
            href={demo}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 text-accent transition-colors hover:opacity-80"
          >
            <Icon name="external" class="size-3.5" />
            {new URL(demo).host}
          </a>
        )}
      </div>
    )
  }
</article>
