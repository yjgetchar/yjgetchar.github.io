---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Timeline from '../components/Timeline.astro';
import Icon from '../components/Icon.astro';
import { profile, expertise, constellation } from '../data/profile';
---

<BaseLayout title="About" description={`${profile.name} 소개 — ${profile.role}`}>
  <div class="mx-auto max-w-4xl space-y-12 px-6 pt-16 pb-24 md:pt-20">
    <header class="flex flex-col gap-8 sm:flex-row sm:items-center">
      <img
        src={profile.avatar}
        alt={profile.name}
        width="144"
        height="144"
        class="size-36 shrink-0 rounded-3xl border-4 border-surface-strong object-cover shadow-lg"
        data-rise
      />
      <div>
        <p class="font-mono text-[11px] font-medium tracking-[0.2em] text-subtle uppercase" data-rise style="--i:1">
          About me
        </p>
        <h1 class="mt-2 font-heading text-4xl font-bold tracking-tight sm:text-5xl" data-rise style="--i:2">
          {profile.name}
        </h1>
        <p class="mt-2 text-muted" data-rise style="--i:3">{profile.role} · {profile.location}</p>
      </div>
    </header>

    <section class="glass rounded-[24px] p-6 sm:rounded-[32px] sm:p-8" data-rise style="--i:4" aria-labelledby="h-intro">
      <SectionHeading eyebrow="Intro" title="안녕하세요" id="h-intro" />
      <div class="space-y-4 leading-relaxed text-muted">
        <p>{profile.intro}</p>
        <!-- TODO: 더 하고 싶은 이야기 (개발을 시작한 계기, 일하는 방식, 관심사 등) -->
        <p>
          새로운 도구가 나오면 직접 써 보고, 일상의 불편함을 작은 자동화로 해결하는 걸 좋아합니다. 요즘은 LLM 에이전트를
          실제로 쓸 만한 제품으로 만드는 방법과, 여러 사람이 함께 즐기는 실시간 인터랙션에 집중하고 있습니다.
        </p>
      </div>
    </section>

    <section class="glass rounded-[24px] p-6 sm:rounded-[32px] sm:p-8" data-reveal aria-labelledby="h-skills">
      <SectionHeading eyebrow="Skills" title="기술 스택" id="h-skills" />
      <div class="grid gap-6 sm:grid-cols-3">
        {
          expertise.map((e) => (
            <div>
              <h3 class="text-sm font-semibold">{e.title}</h3>
              <div class="mt-3 flex flex-wrap gap-1.5">
                {e.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
      <p class="mt-8 font-mono text-[11px] text-subtle">
        constellation: {constellation.join(' · ')}
      </p>
    </section>

    <section class="glass rounded-[24px] p-6 sm:rounded-[32px] sm:p-8" data-reveal aria-labelledby="h-journey">
      <SectionHeading eyebrow="Journey" title="걸어온 길" id="h-journey" />
      <Timeline />
    </section>

    <div class="flex flex-wrap justify-center gap-3" data-reveal>
      <a
        href="/projects"
        class="inline-flex items-center gap-2 rounded-lg bg-fg px-5 py-2.5 text-sm font-medium text-bg transition-opacity hover:opacity-85"
      >
        프로젝트 보기 <Icon name="arrow-right" class="size-4" />
      </a>
      <a
        href="/#contact"
        class="glass inline-flex items-center gap-2 rounded-lg px-5 py-2.5 text-sm font-medium transition-colors hover:bg-surface-strong"
      >
        연락하기
      </a>
    </div>
  </div>
</BaseLayout>
