---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ExperienceList from '../components/ExperienceList.astro';
import Icon from '../components/Icon.astro';
import { linkedin, profile, expertise, stack } from '../data/profile';
---

<BaseLayout title="소개" description={`${profile.name} 소개 — ${profile.role}`}>
  <header class="max-w-2xl">
    <p class="font-mono text-[13px] text-accent" data-rise>~/about</p>
    <h1 class="mt-2 text-[36px] leading-[1.1] font-bold tracking-[-0.03em] sm:text-[44px]" data-rise style="--i:1">
      안녕하세요, {profile.koreanName}입니다.
    </h1>
    <div class="mt-5 space-y-4 text-[17px] leading-relaxed text-muted" data-rise style="--i:2">
      <p>{profile.intro}</p>
      <!-- TODO: 더 하고 싶은 이야기 (개발을 시작한 계기, 일하는 방식, 관심사 등) -->
      <p>
        새로운 도구가 나오면 직접 써 보고, 일상의 불편함을 작은 자동화로 해결하는 걸 좋아합니다. 요즘은 LLM 에이전트를
        실제로 쓸 만한 제품으로 만드는 방법과, 여러 사람이 함께 즐기는 실시간 인터랙션에 집중하고 있어요.
      </p>
    </div>
    <div class="mt-7 flex flex-wrap gap-2.5" data-rise style="--i:3">
      <a href="/projects" class="btn-primary">프로젝트 보기 <Icon name="chevron" class="size-4" /></a>
      <a href={linkedin} target="_blank" rel="noopener" class="btn-secondary">
        <Icon name="linkedin" class="size-4" /> LinkedIn
      </a>
    </div>
  </header>

  <section class="mt-20" aria-labelledby="h-what">
    <SectionTitle id="h-what" title="What I do" />
    <div class="grid gap-4 md:grid-cols-3">
      {
        expertise.map((e) => (
          <div data-reveal class="card glow-card flex flex-col p-6">
            <span class="text-[36px] leading-none" aria-hidden="true">
              {e.emoji}
            </span>
            <h3 class="mt-5 text-[17px] font-bold tracking-tight">{e.title}</h3>
            <p class="mt-2 text-[14px] leading-relaxed text-muted">{e.body}</p>
            <div class="mt-auto flex flex-wrap gap-1.5 pt-5">
              {e.tags.map((t) => (
                <span class="chip">{t}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-20" aria-labelledby="h-exp">
    <SectionTitle id="h-exp" title="Experience" />
    <div data-reveal><ExperienceList /></div>
  </section>

  <section class="mt-20" aria-labelledby="h-stack">
    <SectionTitle id="h-stack" title="Stack" sub="자주 쓰는 기술들" />
    <div data-reveal class="card flex flex-wrap gap-2 p-6">
      {stack.map((s) => <span class="chip px-3.5 py-1.5 text-[14px]">{s}</span>)}
    </div>
  </section>
</BaseLayout>
