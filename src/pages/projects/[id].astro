---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Icon from '../../components/Icon.astro';
import { getRepo } from '../../lib/github';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project, others: projects.filter((p) => p.id !== project.id).slice(0, 2) },
  }));
}

const { project, others } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const info = d.repo ? await getRepo(d.repo) : null;
const dateLabel = d.date.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long' });
---

<BaseLayout title={d.title} description={d.summary}>
  <article>
    <a href="/projects" class="link-more" data-rise>
      <Icon name="chevron" class="size-4 rotate-180" /> 모든 프로젝트
    </a>

    <!-- Title -->
    <header class="mt-6" data-rise style="--i:1">
      <div class="flex flex-wrap gap-1.5">
        <span class="chip">{d.category}</span>
        <span class="chip">{d.status}</span>
        <span class="chip"><time datetime={d.date.toISOString()}>{dateLabel}</time></span>
      </div>
      <h1 class="mt-4 text-[34px] leading-[1.1] font-bold tracking-[-0.03em] sm:text-[42px]">{d.title}</h1>
      <p class="mt-3 max-w-2xl text-[17px] leading-relaxed text-muted">{d.summary}</p>

      <div class="mt-6 flex flex-wrap gap-2.5">
        {
          d.demo && (
            <a href={d.demo} target="_blank" rel="noopener" class="btn-primary">
              사이트 열기 <Icon name="external" class="size-4" />
            </a>
          )
        }
        {
          d.repo && (
            <a
              href={info?.html_url ?? `https://github.com/${d.repo}`}
              target="_blank"
              rel="noopener"
              class={d.demo ? 'btn-secondary' : 'btn-primary'}
            >
              <Icon name="github" class="size-4" /> GitHub
              {info && (
                <span class="inline-flex items-center gap-0.5 text-[13px] opacity-70">
                  <Icon name="star" class="size-3" />
                  {info.stargazers_count}
                </span>
              )}
            </a>
          )
        }
        {!d.demo && !d.repo && <p class="text-[13px] text-subtle">🔒 비공개 프로젝트예요.</p>}
      </div>
    </header>

    <!-- Cover -->
    <div class="card mt-8 overflow-hidden bg-surface-2" data-rise style="--i:2">
      <Image
        src={d.cover}
        alt={`${d.title} 대표 이미지`}
        widths={[600, 1000]}
        sizes="(min-width: 1200px) 780px, 100vw"
        loading="eager"
        class="h-auto max-h-[520px] w-full object-cover"
      />
    </div>

    <div class="mt-4 flex flex-wrap gap-1.5">
      {d.tags.map((t) => <span class="chip">{t}</span>)}
    </div>

    <!-- Highlights -->
    {
      d.highlights.length > 0 && (
        <section class="mt-10 grid gap-3 sm:grid-cols-2" aria-label="하이라이트">
          {d.highlights.map((h, i) => (
            <div data-reveal class="card flex gap-4 p-5">
              <span class="grid size-8 shrink-0 place-items-center rounded-full bg-accent-bg/15 font-mono text-[13px] font-bold text-accent">
                {i + 1}
              </span>
              <p class="text-[15px] leading-relaxed">{h}</p>
            </div>
          ))}
        </section>
      )
    }

    <!-- Body -->
    <div class="prose-body mt-14 max-w-[720px]">
      <Content />
    </div>

    <!-- More projects -->
    {
      others.length > 0 && (
        <section class="mt-24" aria-labelledby="h-more">
          <h2 id="h-more" class="section-title mb-6">
            다른 프로젝트
          </h2>
          <div class="grid gap-5 sm:grid-cols-2">
            {others.map((p) => (
              <div data-reveal>
                <ProjectCard project={p} />
              </div>
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
