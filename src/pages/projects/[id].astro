---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getRepo } from '../../lib/github';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: { project, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const info = d.repo ? await getRepo(d.repo) : null;
const dateLabel = d.date.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long' });
---

<BaseLayout title={d.title} description={d.summary}>
  <article class="mx-auto max-w-3xl px-6 pt-12 pb-24 md:pt-16">
    <a
      href="/projects"
      class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-accent"
      data-rise
    >
      <Icon name="chevron" class="size-4 rotate-180" /> 모든 프로젝트
    </a>

    <header class="mt-8" data-rise style="--i:1">
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-subtle">
        <span class="rounded-full border border-line px-2.5 py-0.5">{d.category}</span>
        <span>·</span>
        <span>{d.status}</span>
        <span>·</span>
        <time datetime={d.date.toISOString()}>{dateLabel}</time>
      </div>
      <h1 class="mt-4 flex items-center gap-3 font-heading text-4xl font-bold tracking-tight sm:text-5xl">
        <span aria-hidden="true">{d.icon}</span>
        {d.title}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-muted">{d.summary}</p>

      <div class="mt-6 flex flex-wrap gap-3">
        {
          d.repo && (
            <a
              href={info?.html_url ?? `https://github.com/${d.repo}`}
              target="_blank"
              rel="noopener"
              class="glass inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm font-medium transition-colors hover:bg-surface-strong"
            >
              <Icon name="github" class="size-4" /> GitHub
              {info && (
                <span class="inline-flex items-center gap-0.5 font-mono text-xs text-subtle">
                  <Icon name="star" class="size-3" />
                  {info.stargazers_count}
                </span>
              )}
            </a>
          )
        }
        {
          d.demo && (
            <a
              href={d.demo}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-lg bg-fg px-4 py-2.5 text-sm font-medium text-bg transition-opacity hover:opacity-85"
            >
              <Icon name="external" class="size-4" /> Live Demo
            </a>
          )
        }
      </div>

      <div class="mt-6 flex flex-wrap gap-1.5">
        {d.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </header>

    {
      d.highlights.length > 0 && (
        <section
          class="glass mt-10 rounded-2xl p-6"
          aria-labelledby="h-highlights"
          data-rise
          style="--i:2"
        >
          <h2 id="h-highlights" class="font-mono text-[11px] font-medium tracking-[0.2em] text-accent uppercase">
            Highlights
          </h2>
          <ul class="mt-4 space-y-2.5">
            {d.highlights.map((h) => (
              <li class="flex gap-3 text-sm leading-relaxed text-muted">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                {h}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="glass prose-body mt-8 rounded-2xl p-6 sm:p-8">
      <Content />
    </div>

    <nav class="mt-12 grid gap-4 sm:grid-cols-2" aria-label="다른 프로젝트">
      {
        prev ? (
          <a href={`/projects/${prev.id}`} class="glass lift rounded-2xl p-5">
            <span class="font-mono text-[11px] text-subtle">← 이전</span>
            <span class="mt-1 block font-heading font-semibold">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/projects/${next.id}`} class="glass lift rounded-2xl p-5 text-right">
            <span class="font-mono text-[11px] text-subtle">다음 →</span>
            <span class="mt-1 block font-heading font-semibold">{next.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>
