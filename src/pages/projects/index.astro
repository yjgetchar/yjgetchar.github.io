---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectPin from '../../components/ProjectPin.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order || b.data.date.getTime() - a.data.date.getTime(),
);
const categories = [...new Set(projects.map((p) => p.data.category))];

// Pure-CSS filter: radio inputs + :has(), no client JS needed.
const filterCss = categories
  .map((c) => `.project-filter:has(#cat-${c}:checked) [data-cat]:not([data-cat="${c}"]){display:none}`)
  .join('\n');
---

<BaseLayout title="프로젝트" description="지금까지 만든 프로젝트 모음">
  <style is:inline set:html={filterCss}></style>

  <section class="project-filter mx-auto max-w-[1120px] px-4 pt-14 sm:px-5 md:pt-20">
    <header class="max-w-2xl">
      <h1 class="text-[44px] leading-[1.05] font-bold tracking-[-0.035em] sm:text-[56px]" data-rise>프로젝트.</h1>
      <p class="mt-3 text-[19px] leading-relaxed text-muted sm:text-[21px]" data-rise style="--i:1">
        AI 에이전트, 게임, 자동화 도구까지. 하나하나 직접 기획하고 만들었어요.
      </p>
    </header>

    <fieldset class="sticky top-[3.25rem] z-20 -mx-4 mt-10 bg-bg/80 px-4 py-3 backdrop-blur-xl sm:-mx-5 sm:px-5" data-rise style="--i:2">
      <legend class="sr-only">카테고리 필터</legend>
      <div class="flex gap-2 overflow-x-auto">
        <input type="radio" name="cat" id="cat-all" class="sr-only" checked />
        <label for="cat-all" class="filter-pill">전체</label>
        {
          categories.map((c) => (
            <>
              <input type="radio" name="cat" id={`cat-${c}`} class="sr-only" />
              <label for={`cat-${c}`} class="filter-pill">
                {c}
              </label>
            </>
          ))
        }
      </div>
    </fieldset>

    <div class="masonry mt-6">
      {
        projects.map((p, i) => (
          <div data-cat={p.data.category}>
            <ProjectPin project={p} eager={i < 3} />
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* Pinterest-like filter pills */
  .filter-pill {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 1.1rem;
    border-radius: 999px;
    background-color: color-mix(in oklab, var(--fg) 6%, transparent);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--fg);
    cursor: pointer;
    transition:
      background-color 200ms,
      color 200ms;
  }
  .filter-pill:hover {
    background-color: color-mix(in oklab, var(--fg) 11%, transparent);
  }
  input:checked + .filter-pill {
    background-color: var(--fg);
    color: var(--bg);
  }
  input:focus-visible + .filter-pill {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
