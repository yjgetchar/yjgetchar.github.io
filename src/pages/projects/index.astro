---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order || b.data.date.getTime() - a.data.date.getTime(),
);
const categories = [...new Set(projects.map((p) => p.data.category))];

// Pure-CSS filter: radio inputs + :has(), no client JS needed.
const filterCss = categories
  .map((c) => `.project-filter:has(#cat-${c}:checked) [data-cat]:not([data-cat="${c}"]){display:none}`)
  .join('\n');
---

<BaseLayout title="프로젝트" description="지금까지 만든 프로젝트 모음">
  <style is:inline set:html={filterCss}></style>

  <section class="project-filter">
    <header class="max-w-2xl">
      <p class="font-mono text-[13px] text-accent" data-rise>~/projects</p>
      <h1 class="mt-2 text-[36px] leading-[1.1] font-bold tracking-[-0.03em] sm:text-[44px]" data-rise style="--i:1">
        Projects
      </h1>
      <p class="mt-3 text-[17px] leading-relaxed text-muted" data-rise style="--i:2">
        AI 에이전트, 게임, 자동화 도구까지. 하나하나 직접 기획하고 만들었어요.
      </p>
    </header>

    <fieldset
      class="sticky top-14 z-20 -mx-4 mt-8 bg-bg/80 px-4 py-3 backdrop-blur-xl sm:-mx-6 sm:px-6 lg:top-0 lg:mx-0 lg:px-0"
      data-rise
      style="--i:3"
    >
      <legend class="sr-only">카테고리 필터</legend>
      <div class="flex gap-2 overflow-x-auto">
        <input type="radio" name="cat" id="cat-all" class="sr-only" checked />
        <label for="cat-all" class="filter-pill">전체 <span class="opacity-60">{projects.length}</span></label>
        {
          categories.map((c) => (
            <>
              <input type="radio" name="cat" id={`cat-${c}`} class="sr-only" />
              <label for={`cat-${c}`} class="filter-pill">
                {c}
              </label>
            </>
          ))
        }
      </div>
    </fieldset>

    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {
        projects.map((p, i) => (
          <div data-cat={p.data.category}>
            <ProjectCard project={p} eager={i < 2} />
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .filter-pill {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.5rem;
    padding: 0 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
    cursor: pointer;
    transition:
      background-color 200ms,
      border-color 200ms,
      color 200ms;
  }
  .filter-pill:hover {
    color: var(--fg);
    border-color: color-mix(in oklab, var(--fg) 20%, transparent);
  }
  input:checked + .filter-pill {
    border-color: color-mix(in oklab, var(--accent-bg) 60%, transparent);
    background-color: color-mix(in oklab, var(--accent-bg) 16%, transparent);
    color: var(--fg);
  }
  input:focus-visible + .filter-pill {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
