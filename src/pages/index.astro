---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Timeline from '../components/Timeline.astro';
import GitHubActivity from '../components/GitHubActivity.astro';
import Icon from '../components/Icon.astro';
import { profile, stats, expertise, sections } from '../data/profile';

const all = await getCollection('projects');
const featured = all
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

// Number sections dynamically so toggling one off keeps the sequence tidy.
let n = 0;
const next = () => ++n;

const toneBorder: Record<string, string> = {
  accent: 'border-l-accent/50',
  'accent-2': 'border-l-accent-2/50',
};
const toneTag: Record<string, string> = {
  accent: 'text-accent bg-accent-soft border-accent/20',
  'accent-2': 'text-accent-2 bg-accent-2/10 border-accent-2/20',
};
---

<BaseLayout structuredData>
  <!-- Hero -->
  <section class="px-6 pt-16 pb-10 md:pt-24 md:pb-14">
    <div class="mx-auto flex w-full max-w-6xl flex-col md:flex-row md:items-center md:gap-16">
      <div class="min-w-0 flex-1">
        <div
          data-rise
          class="inline-flex items-center gap-2 rounded-full border border-accent/25 bg-surface px-3.5 py-1.5 backdrop-blur"
        >
          <span class="relative flex size-2">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-60 motion-reduce:hidden"
            ></span>
            <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
          </span>
          <span class="font-mono text-[11px] font-medium tracking-[0.18em] text-accent uppercase">{profile.role}</span>
        </div>

        <h1
          data-rise
          style="--i:1"
          class="hero-gradient mt-6 pb-2 font-heading text-6xl font-bold tracking-tight sm:text-7xl lg:text-8xl"
        >
          {profile.name}
        </h1>
        <p
          data-rise
          style="--i:2"
          class="mt-4 font-heading text-xl font-medium whitespace-pre-line text-fg/85 sm:text-2xl"
        >
          {profile.headline}
        </p>
        <p data-rise style="--i:3" class="mt-6 max-w-xl leading-relaxed text-muted">{profile.intro}</p>

        <div data-rise style="--i:4" class="mt-9 flex flex-wrap gap-3">
          {
            profile.socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                class="group glass inline-flex items-center gap-2.5 rounded-lg px-4 py-2.5 text-sm font-medium transition-[background-color,border-color,box-shadow] hover:border-accent/30 hover:bg-surface-strong hover:shadow-sm sm:px-5"
              >
                <Icon name={s.icon} class="size-4 text-muted transition-colors group-hover:text-fg" />
                {s.label}
              </a>
            ))
          }
          <a
            href="/projects"
            class="inline-flex items-center gap-2 rounded-lg bg-fg px-4 py-2.5 text-sm font-medium text-bg transition-opacity hover:opacity-85 sm:px-5"
          >
            프로젝트 보기
            <Icon name="arrow-right" class="size-4" />
          </a>
        </div>

        <p data-rise style="--i:5" class="mt-8 hidden font-mono text-xs text-subtle sm:block">
          <span class="text-accent">$</span> 배경의 별자리는 제가 쓰는 기술 스택이에요. 마우스를 움직이거나 빈 곳을 클릭해 보세요.
        </p>
      </div>

      <div data-rise style="--i:2" class="hidden shrink-0 md:block">
        <div class="relative">
          <div
            class="absolute -inset-5 rounded-full bg-gradient-to-br from-accent/20 to-accent-2/20 blur-2xl"
            aria-hidden="true"
          >
          </div>
          <img
            src={profile.avatar}
            alt={profile.name}
            width="208"
            height="208"
            fetchpriority="high"
            class="relative size-52 rounded-full border-[6px] border-surface-strong object-cover shadow-xl"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  {
    sections.stats && (
      <section class="px-6 pb-16" aria-label="요약">
        <div class="mx-auto grid max-w-6xl gap-4 md:grid-cols-3">
          {stats.map((s, i) => (
            <a href={s.href} data-rise style={`--i:${i + 5}`} class="glass lift group rounded-2xl p-5">
              <p class="font-heading text-3xl font-bold">
                {s.value}
                <span class="text-accent">{s.suffix}</span>
              </p>
              <p class="mt-1.5 text-sm font-medium transition-colors group-hover:text-accent">{s.label}</p>
              <p class="mt-0.5 font-mono text-[11px] text-subtle">{s.caption}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <div class="mx-auto max-w-6xl space-y-12 px-6 pb-24 sm:space-y-20">
    <!-- Expertise -->
    {
      sections.expertise && (
        <section
          id="expertise"
          aria-labelledby="h-expertise"
          data-reveal
          class="glass scroll-mt-24 rounded-[24px] p-5 shadow-xl shadow-black/5 sm:rounded-[32px] sm:p-8"
        >
          <SectionHeading index={next()} eyebrow="What I do" title="무엇을 하는가" id="h-expertise" />
          <div class="grid gap-5 lg:grid-cols-3">
            {expertise.map((e) => (
              <div class:list={['rounded-2xl border border-l-2 border-line bg-surface-strong/40 p-6', toneBorder[e.tone]]}>
                <h3 class="font-heading text-lg font-semibold">{e.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{e.body}</p>
                <div class="mt-4 flex flex-wrap gap-1.5">
                  {e.tags.map((t) => (
                    <span class:list={['rounded-md border px-2 py-0.5 font-mono text-[11px]', toneTag[e.tone]]}>{t}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- Featured projects -->
    {
      sections.projects && (
        <section
          id="projects"
          aria-labelledby="h-projects"
          data-reveal
          class="glass scroll-mt-24 rounded-[24px] p-5 shadow-xl shadow-black/5 sm:rounded-[32px] sm:p-8"
        >
          <SectionHeading index={next()} eyebrow="Featured Work" title="대표 프로젝트" id="h-projects" />
          <div class="grid gap-5 md:grid-cols-2">
            {featured.map((p) => (
              <ProjectCard project={p} />
            ))}
          </div>
          <div class="mt-7 text-center">
            <a
              href="/projects"
              class="inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-accent"
            >
              {all.length}개 프로젝트 전체 보기
              <Icon name="arrow-right" class="size-4" />
            </a>
          </div>
        </section>
      )
    }

    <!-- Timeline -->
    {
      sections.timeline && (
        <section
          id="journey"
          aria-labelledby="h-journey"
          data-reveal
          class="glass scroll-mt-24 rounded-[24px] p-5 shadow-xl shadow-black/5 sm:rounded-[32px] sm:p-8"
        >
          <SectionHeading index={next()} eyebrow="Journey" title="걸어온 길" id="h-journey" />
          <Timeline />
        </section>
      )
    }

    <!-- GitHub activity -->
    {
      sections.github && (
        <section
          id="github"
          aria-labelledby="h-github"
          data-reveal
          class="glass scroll-mt-24 rounded-[24px] p-5 shadow-xl shadow-black/5 sm:rounded-[32px] sm:p-8"
        >
          <SectionHeading index={next()} eyebrow="Activity" title="GitHub 활동" id="h-github" />
          <GitHubActivity />
        </section>
      )
    }

    <!-- Contact -->
    {
      sections.contact && (
        <section
          id="contact"
          aria-labelledby="h-contact"
          data-reveal
          class="glass scroll-mt-24 rounded-[24px] p-6 text-center shadow-xl shadow-black/5 sm:rounded-[32px] sm:p-10"
        >
          <div class="font-mono text-[11px] font-medium tracking-[0.2em] text-subtle uppercase">
            <span class="text-accent">{String(next()).padStart(2, '0')}</span> — Contact
          </div>
          <h2 id="h-contact" class="mt-3 font-heading text-2xl font-semibold sm:text-3xl">
            함께 만들고 싶은 게 있다면
          </h2>
          <p class="mt-3 text-sm text-muted">협업 제안, 피드백, 아이디어 모두 환영합니다.</p>
          <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
            {profile.email ? (
              <a
                href={`mailto:${profile.email}`}
                class="inline-flex items-center gap-2.5 rounded-lg bg-fg px-6 py-3 text-sm font-medium text-bg transition-opacity hover:opacity-85"
              >
                <Icon name="mail" class="size-4" />
                {profile.email}
              </a>
            ) : (
              <a
                href={`https://github.com/${profile.github}`}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2.5 rounded-lg bg-fg px-6 py-3 text-sm font-medium text-bg transition-opacity hover:opacity-85"
              >
                <Icon name="github" class="size-4" />
                GitHub에서 연락하기
              </a>
            )}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
