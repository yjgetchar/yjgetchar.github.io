---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileCard from '../components/ProfileCard.astro';
import AboutIntro from '../components/AboutIntro.astro';
import ExperienceList from '../components/ExperienceList.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import { linkedin, profile, sections } from '../data/profile';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((p) => p.data.featured);
const now = all.find((p) => p.data.status === 'In Progress');
---

<BaseLayout structuredData>
  <h1 class="sr-only">{profile.name} — {profile.role}</h1>

  <!-- Mobile only: the sidebar profile becomes the first card -->
  <div class="card mb-14 px-6 py-8 lg:hidden" data-rise>
    <ProfileCard eager />
  </div>

  <div class="flex flex-col gap-20 sm:gap-24">
    {sections.about && <AboutIntro now={now} />}

    {
      sections.experience && (
        <section id="experience" aria-labelledby="h-experience" class="scroll-mt-20" data-reveal>
          <SectionTitle id="h-experience" title="Experience" />
          <ExperienceList />
        </section>
      )
    }

    {
      sections.projects && (
        <section id="projects" aria-labelledby="h-projects" class="scroll-mt-20">
          <SectionTitle id="h-projects" title="Projects" sub="직접 기획하고, 만들고, 운영해요." href="/projects" />
          <div class="grid gap-5 sm:grid-cols-2">
            {featured.map((p, i) => (
              <div data-reveal>
                <ProjectCard project={p} eager={i < 2} />
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      sections.contact && (
        <section id="contact" aria-labelledby="h-contact" class="scroll-mt-20" data-reveal>
          <div class="card overflow-hidden px-6 py-12 text-center sm:px-10 sm:py-14">
            <div
              class="pointer-events-none absolute inset-x-0 -top-24 mx-auto h-48 w-3/4 rounded-full bg-accent-bg/20 blur-3xl"
              aria-hidden="true"
            />
            <p class="text-[40px] leading-none" aria-hidden="true">
              👋
            </p>
            <h2 id="h-contact" class="mt-5 text-[28px] font-bold tracking-[-0.03em] sm:text-[32px]">
              함께 만들어요.
            </h2>
            <p class="mx-auto mt-3 max-w-md text-[16px] text-muted">협업 제안, 피드백, 아이디어 모두 환영합니다.</p>
            <div class="mt-8 flex flex-wrap justify-center gap-2.5">
              {profile.email && (
                <a href={`mailto:${profile.email}`} class="btn-secondary">
                  <Icon name="mail" class="size-4" /> {profile.email}
                </a>
              )}
              <a href={linkedin} target="_blank" rel="noopener" class="btn-primary">
                <Icon name="linkedin" class="size-4" /> LinkedIn으로 연락하기
              </a>
              <a href={`https://github.com/${profile.github}`} target="_blank" rel="noopener" class="btn-secondary">
                <Icon name="github" class="size-4" /> GitHub
              </a>
            </div>
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
