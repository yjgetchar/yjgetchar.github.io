---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="404" description="페이지를 찾을 수 없습니다.">
  <section class="mx-auto flex max-w-xl flex-col items-center px-6 py-32 text-center">
    <p class="hero-gradient font-heading text-8xl font-bold" data-rise>404</p>
    <h1 class="mt-4 font-heading text-2xl font-semibold" data-rise style="--i:1">이 별은 아직 지도에 없어요</h1>
    <p class="mt-3 text-muted" data-rise style="--i:2">주소가 바뀌었거나 존재하지 않는 페이지입니다.</p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 rounded-lg bg-fg px-5 py-2.5 text-sm font-medium text-bg transition-opacity hover:opacity-85"
      data-rise
      style="--i:3"
    >
      홈으로 <Icon name="arrow-right" class="size-4" />
    </a>
  </section>
</BaseLayout>
